  {"id":"gr-g-desu-ex1",      "type":"grammar-example","level":"elementary","text":"これは本です。",                "outputPath":"public/audio/grammar/g-desu_ex1.mp3",      "audioUrl":"/audio/grammar/g-desu_ex1.mp3",      "page":"/grammar/g-desu",    "sourceId":"g-desu"},
  {"id":"gr-g-wa-ex0",        "type":"grammar-example","level":"elementary","text":"わたしは日本語を勉強しています。","outputPath":"public/audio/grammar/g-wa_ex0.mp3",        "audioUrl":"/audio/grammar/g-wa_ex0.mp3",        "page":"/grammar/g-wa",      "sourceId":"g-wa"},
  {"id":"gr-g-wa-ex1",        "type":"grammar-example","level":"elementary","text":"このレストランはおいしいです。",  "outputPath":"public/audio/grammar/g-wa_ex1.mp3",        "audioUrl":"/audio/grammar/g-wa_ex1.mp3",        "page":"/grammar/g-wa",      "sourceId":"g-wa"},
  {"id":"gr-g-te-iru-ex0",    "type":"grammar-example","level":"n5",       "text":"今、ご飯を食べています。",       "outputPath":"public/audio/grammar/g-te-iru_ex0.mp3",    "audioUrl":"/audio/grammar/g-te-iru_ex0.mp3",    "page":"/grammar/g-te-iru",  "sourceId":"g-te-iru"},
  {"id":"gr-g-te-iru-ex1",    "type":"grammar-example","level":"n5",       "text":"彼女は結婚しています。",         "outputPath":"public/audio/grammar/g-te-iru_ex1.mp3",    "audioUrl":"/audio/grammar/g-te-iru_ex1.mp3",    "page":"/grammar/g-te-iru",  "sourceId":"g-te-iru"},
  {"id":"gr-g-potential-ex0", "type":"grammar-example","level":"n4",       "text":"日本語が話せます。",             "outputPath":"public/audio/grammar/g-potential_ex0.mp3", "audioUrl":"/audio/grammar/g-potential_ex0.mp3", "page":"/grammar/g-potential","sourceId":"g-potential"},
  {"id":"gr-g-potential-ex1", "type":"grammar-example","level":"n4",       "text":"この魚は生で食べられます。",     "outputPath":"public/audio/grammar/g-potential_ex1.mp3", "audioUrl":"/audio/grammar/g-potential_ex1.mp3", "page":"/grammar/g-potential","sourceId":"g-potential"},
  {"id":"gr-g-tara-ex0",      "type":"grammar-example","level":"n4",       "text":"雨が降ったら、試合は中止です。", "outputPath":"public/audio/grammar/g-tara_ex0.mp3",      "audioUrl":"/audio/grammar/g-tara_ex0.mp3",      "page":"/grammar/g-tara",    "sourceId":"g-tara"},
  {"id":"gr-g-tara-ex1",      "type":"grammar-example","level":"n4",       "text":"宿題が終わったら、遊んでもいいよ。","outputPath":"public/audio/grammar/g-tara_ex1.mp3",   "audioUrl":"/audio/grammar/g-tara_ex1.mp3",      "page":"/grammar/g-tara",    "sourceId":"g-tara"},
  {"id":"gr-g-causative-ex0", "type":"grammar-example","level":"n4",       "text":"先生は学生に本を読ませました。", "outputPath":"public/audio/grammar/g-causative_ex0.mp3", "audioUrl":"/audio/grammar/g-causative_ex0.mp3", "page":"/grammar/g-causative","sourceId":"g-causative"},
  {"id":"gr-g-causative-ex1", "type":"grammar-example","level":"n4",       "text":"母は子供に野菜を食べさせます。", "outputPath":"public/audio/grammar/g-causative_ex1.mp3", "audioUrl":"/audio/grammar/g-causative_ex1.mp3", "page":"/grammar/g-causative","sourceId":"g-causative"},
  {"id":"gr-g-passive-ex0",   "type":"grammar-example","level":"n4",       "text":"私は先生に褒められました。",     "outputPath":"public/audio/grammar/g-passive_ex0.mp3",   "audioUrl":"/audio/grammar/g-passive_ex0.mp3",   "page":"/grammar/g-passive",  "sourceId":"g-passive"},
  {"id":"gr-g-te-shimau-ex0", "type":"grammar-example","level":"n4",       "text":"宿題を家に忘れてしまいました。", "outputPath":"public/audio/grammar/g-te-shimau_ex0.mp3", "audioUrl":"/audio/grammar/g-te-shimau_ex0.mp3", "page":"/grammar/g-te-shimau","sourceId":"g-te-shimau"},
  {"id":"gr-g-te-shimau-ex1", "type":"grammar-example","level":"n4",       "text":"ケーキを全部食べちゃった。",     "outputPath":"public/audio/grammar/g-te-shimau_ex1.mp3", "audioUrl":"/audio/grammar/g-te-shimau_ex1.mp3", "page":"/grammar/g-te-shimau","sourceId":"g-te-shimau"},
  {"id":"gr-g-te-oku-ex0",    "type":"grammar-example","level":"n4",       "text":"試験の前に単語を覚えておきます。","outputPath":"public/audio/grammar/g-te-oku_ex0.mp3",   "audioUrl":"/audio/grammar/g-te-oku_ex0.mp3",    "page":"/grammar/g-te-oku",  "sourceId":"g-te-oku"},
  {"id":"gr-g-te-oku-ex1",    "type":"grammar-example","level":"n4",       "text":"ドアを開けておいてください。",   "outputPath":"public/audio/grammar/g-te-oku_ex1.mp3",   "audioUrl":"/audio/grammar/g-te-oku_ex1.mp3",    "page":"/grammar/g-te-oku",  "sourceId":"g-te-oku"},
  {"id":"gr-g-soo-da-ex0",    "type":"grammar-example","level":"n4",       "text":"このケーキ、おいしそうですね。", "outputPath":"public/audio/grammar/g-soo-da_ex0.mp3",   "audioUrl":"/audio/grammar/g-soo-da_ex0.mp3",    "page":"/grammar/g-soo-da",  "sourceId":"g-soo-da"},
